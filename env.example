# NASA API Configuration
# Get your free API key from: https://api.nasa.gov/
# For development, you can use DEMO_KEY but it has rate limits
NASA_API_KEY=your_nasa_api_key_here

# WebSocket Configuration
# For development (when running `wrangler dev` in durable-object folder)
NEXT_PUBLIC_WS_HOST=localhost:8787
# For production (replace with your deployed worker URL)
# NEXT_PUBLIC_WS_HOST=your-worker-name.your-subdomain.workers.dev

# Example:
# NASA_API_KEY=abc123def456ghi789jkl012mno345pqr678stu
# NEXT_PUBLIC_WS_HOST=chat-worker.example.workers.dev

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace 'your_nasa_api_key_here' with your actual NASA API key
# 3. Get your free API key from: https://api.nasa.gov/
# 4. For development: Keep NEXT_PUBLIC_WS_HOST=localhost:8787
# 5. For production: Replace with your deployed Durable Object worker URL 