---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getPosts, tagHref, type Post } from "../../lib/blog";

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content, headings } = await render(post.entry);

// Only h2/h3 make a useful outline; h4 and deeper turn it into a wall.
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout title={post.title} description={post.description} ogImage={`${post.href}og.png`} ogType="article">
	<main class="article-wrap">
		<article class="article">
			<header>
				<a class="back-link" href="/blog/">Back to blog</a>
				<h1>{post.title}</h1>
				<p class="article-meta">
					{formatDate(post.date)} <span class="sep">·</span> {post.readingMinutes} min read
				</p>
				{post.tags.length > 0 && (
					<ul class="tags" aria-label="Tags">
						{post.tags.map((tag) => (
							<li><a href={tagHref(tag)}>{tag}</a></li>
						))}
					</ul>
				)}
			</header>

			{toc.length > 1 && (
				<nav class="toc" aria-labelledby="toc-heading">
					<p id="toc-heading">Contents</p>
					<ol>
						{toc.map((heading) => (
							<li data-depth={heading.depth}>
								<a href={`#${heading.slug}`}>{heading.text}</a>
							</li>
						))}
					</ol>
				</nav>
			)}

			<div class="prose">
				<Content />
			</div>
		</article>
	</main>
</BaseLayout>
