---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getPosts, getTags, tagHref } from "../../lib/blog";

const posts = await getPosts();
const tags = await getTags();
---

<BaseLayout title="Blog" description="Posts about homelab projects and technical experiments.">
	<main class="page">
		<section class="page-heading reveal">
			<h1>Blog</h1>
			<p>Notes on homelab projects, infrastructure, and the occasional debugging session.</p>
		</section>

		{tags.length > 0 && (
			<nav class="tag-cloud" aria-label="Browse by tag">
				{tags.map((tag) => (
					<a href={tagHref(tag.name)}>{tag.name} <span class="tag-count">{tag.posts.length}</span></a>
				))}
			</nav>
		)}

		<div class="post-list">
			{posts.map((post) => (
				<article class="post-card">
					<div class="post-card-body">
						<p>{formatDate(post.date)} <span class="sep">·</span> {post.readingMinutes} min read</p>
						<h2><a href={post.href}>{post.title}</a></h2>
						{post.description && <p>{post.description}</p>}
						{post.tags.length > 0 && (
							<ul class="tags" aria-label="Tags">
								{post.tags.map((tag) => (
									<li><a href={tagHref(tag)}>{tag}</a></li>
								))}
							</ul>
						)}
					</div>
				</article>
			))}
		</div>
	</main>
</BaseLayout>
