---
import BaseLayout from "../../layouts/BaseLayout.astro";

const postModules = import.meta.glob("../../content/blog/**/index.md", { eager: true });
const posts = Object.entries(postModules)
	.map(([path, post]) => {
		const module = post as { frontmatter: Record<string, any> };
		const folder = path.split("/").at(-2) ?? "";
		return {
			slug: module.frontmatter.slug ?? folder,
			title: module.frontmatter.title,
			description: module.frontmatter.description,
			date: new Date(module.frontmatter.date),
			tags: module.frontmatter.tags ?? [],
		};
	})
	.sort((a, b) => b.date.valueOf() - a.date.valueOf());
---

<BaseLayout title="Blog" description="Posts about homelab projects and technical experiments.">
	<main class="page">
		<section class="page-heading reveal">
			<h1>Blog</h1>
			<p>Notes on homelab projects, infrastructure, and the occasional debugging session.</p>
		</section>

		<div class="post-list">
			{posts.map((post) => (
				<article class="post-card">
					<div class="post-card-body">
						<p>{post.date.toLocaleDateString("en", { year: "numeric", month: "long", day: "numeric" })}</p>
						<h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2>
						{post.description && <p>{post.description}</p>}
						{post.tags.length > 0 && (
							<ul class="tags" aria-label="Tags">
								{post.tags.map((tag: string) => <li>{tag}</li>)}
							</ul>
						)}
					</div>
				</article>
			))}
		</div>
	</main>
</BaseLayout>
