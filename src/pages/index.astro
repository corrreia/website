---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate, getPosts } from "../lib/blog";

const posts = (await getPosts()).slice(0, 3);
---

<BaseLayout>
	<main>
		<section class="hero reveal">
			<h1>
				<span class="accent-italic">Tomás</span> Correia
			</h1>
			<p class="hero-role">
				Engineering @ <a href="https://en.institutional.meo.pt/">MEO</a>
			</p>
			<p class="hero-tags">
				WebDev <span class="sep">·</span> Homelabbing <span class="sep">·</span> Home automation
			</p>
		</section>

		<section class="section">
			<div class="section-heading">
				<h2>Latest Posts</h2>
				<a class="more-link" href="/blog/">
					All posts <span class="arrow" aria-hidden="true">→</span>
				</a>
			</div>
			<div class="post-list">
				{posts.map((post) => (
					<article class="post-card">
						<div class="post-card-body">
							<p>{formatDate(post.date)} <span class="sep">·</span> {post.readingMinutes} min read</p>
							<h3><a href={post.href}>{post.title}</a></h3>
							{post.description && <p>{post.description}</p>}
						</div>
					</article>
				))}
			</div>
		</section>
	</main>
</BaseLayout>
