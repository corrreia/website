---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const siteTitle = "Tomás Correia";
const {
	title = siteTitle,
	description = "Collection of my adventures in tech and in my homelab",
} = Astro.props;
const pageTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/img/social.png" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Geist:wght@300..700&family=JetBrains+Mono:wght@400;500&display=swap"
		/>
		<title>{pageTitle}</title>
	</head>
	<body>
		<div class="bg-atmosphere" aria-hidden="true"></div>
		<header class="site-header">
			<a class={`brand${isHome ? " brand-mark-only" : ""}`} href="/" aria-label="Tomás Correia — home">
				<img src="/img/justme.png" alt="" width="40" height="40" />
				<span>Tomás Correia</span>
			</a>
			<nav aria-label="Primary navigation">
				<a href="/blog/">Blog</a>
				<a href="https://cv.tomascorreia.net">CV</a>
				<a href="https://github.com/corrreia">GitHub</a>
			</nav>
		</header>
		<slot />
		<footer class="site-footer">
			<p>
				<span class="footer-mark">/</span>
				Copyright © {new Date().getFullYear()} Tomás Correia.
			</p>
		</footer>
	</body>
</html>
